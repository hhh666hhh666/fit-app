# 构建产物与依赖
target/
node_modules/
dist/
dist-ssr/
*.log

# apk 内置的 H5 产物：由 scripts/build-apk-web.sh 生成，不入库
android-shell/app/src/main/assets/web/
android-shell/app/build/

# 本机运行配置（含密码与 JWT 密钥），绝不入库
.env
.env.local
.env.*.local

# 本机数据库数据目录（docker-compose.dev.yml 的 MYSQL_DATA_DIR 指向这里）
.data/

# 编辑器与系统
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# AI 工具的本地状态与本机设置（不入库）
.workbuddy/
# 外部设计 skill 装在项目级、但不入库，换机器按 docs/design/设计skill清单.md 的来源重装
.claude/skills/

# ui-ux-pro-max 的 --persist 会往仓库根写这个目录（本项目禁用该行为，此处兜底防手滑）
design-system/

# vite 编译配置时的临时产物（出现即不该入库）
*.timestamp-*.mjs
