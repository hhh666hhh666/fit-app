<?xml version="1.0" encoding="utf-8"?>
<!--
  图标底层：晴窗的天光——冷调浅蓝灰竖向渐变，右上一团浅蓝光晕、左下一团浅杏光晕，
  与 App 页面底（frontend/src/uni.scss 的 $app-canvas-bg）同一套配方，只把颜色压深一点，
  免得放在浅色壁纸上发白。
  渐变要 aapt:attr 内联写法（API 24 起支持，minSdk 26 够用）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 天光：上深下浅 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108">
                <item android:offset="0" android:color="#FFD6E3F2" />
                <item android:offset="0.5" android:color="#FFE9EFF7" />
                <item android:offset="1" android:color="#FFF6F9FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 右上浅蓝光晕 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="92"
                android:centerY="14"
                android:gradientRadius="52">
                <item android:offset="0" android:color="#FFAECDF1" />
                <item android:offset="1" android:color="#00AECDF1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左下浅杏光晕 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="14"
                android:centerY="100"
                android:gradientRadius="50">
                <item android:offset="0" android:color="#CCFFD3BB" />
                <item android:offset="1" android:color="#00FFD3BB" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
