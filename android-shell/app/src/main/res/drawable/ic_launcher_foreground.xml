    <path
        android:fillColor="#D9F24B"
        android:pathData="M37,49 L71,49 L71,59 L37,59 Z" />
    <!-- 左配重片 -->
    <path
        android:fillColor="#D9F24B"
        android:pathData="M23,40 L37,40 L37,68 L23,68 Z" />
    <!-- 右配重片 -->
    <path
