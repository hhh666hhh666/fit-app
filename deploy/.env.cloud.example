# 云端 .env 样例 —— 放到服务器的 /srv/fit-app/.env，**不入库**。
# compose 默认只找自己所在目录的 .env，所以调用方一律显式 --env-file 指向它。

# ── 数据库（复用 quizzy 的 MySQL 容器，见 ADR 0005）──
# ⚠️ 必须与 /srv/quizzy/.env 里的 MYSQL_ROOT_PASSWORD **同值**——是同一个实例，
#    不是「变量同名而已」。填错的表现是后端起不来、报 Access denied。
MYSQL_ROOT_PASSWORD=change-me
# fit_app 库由 JDBC URL 的 createDatabaseIfNotExist=true 自动创建，不需要手工建。
# ⚠️ 云上**没有** MYSQL_DATA_DIR：数据卷归 quizzy 那边管。

# ── 应用 ──
FITAPP_JWT_SECRET=please-generate-a-random-32-byte-secret
FITAPP_JWT_EXPIRE_DAYS=7
# 同源部署（前端与 /api 同域）不需要 CORS，留空即可。
FITAPP_CORS_ALLOWED_ORIGINS=

# ── 镜像 ──
# ghcr.io：CI 用内置 GITHUB_TOKEN 推送，服务器匿名拉公开包（无需凭据）。
# 与 release.yml 的 env 段保持一致；2026-10-12 从阿里云 ACR 换过来（域名消失）。
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=hhh666hhh666
# 版本由部署脚本传入，这里不写。
APP_VERSION=
