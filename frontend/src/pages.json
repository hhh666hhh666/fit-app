{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": { "navigationBarTitleText": "fit-app", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/login/index",
      "style": { "navigationBarTitleText": "登录" }
    },
    {
      "path": "pages/session/index",
      "style": { "navigationBarTitleText": "训练中" }
    },
    {
      "path": "pages/summary/index",
      "style": { "navigationBarTitleText": "训练完成" }
    },
    {
      "path": "pages/log/index",
      "style": { "navigationBarTitleText": "训练日志", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/detail/index",
      "style": { "navigationBarTitleText": "训练详情" }
    },
    {
      "path": "pages/stats/index",
      "style": { "navigationBarTitleText": "统计", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/body/index",
      "style": { "navigationBarTitleText": "身体档案" }
    },
    {
      "path": "pages/library/index",
      "style": { "navigationBarTitleText": "动作库" }
    },
    {
      "path": "pages/plans/index",
      "style": { "navigationBarTitleText": "训练计划" }
    },
    {
      "path": "pages/plan-edit/index",
      "style": { "navigationBarTitleText": "编辑计划" }
    },
    {
      "path": "pages/diet/index",
      "style": { "navigationBarTitleText": "饮食记录" }
    },
    {
      "path": "pages/foods/index",
      "style": { "navigationBarTitleText": "食物库" }
    },
    {
      "path": "pages/food-edit/index",
      "style": { "navigationBarTitleText": "编辑食物" }
    },
    {
      "path": "pages/food-detail/index",
      "style": { "navigationBarTitleText": "食物详情" }
    },
    {
      "path": "pages/settings/index",
      "style": { "navigationBarTitleText": "设置" }
    },
    {
      "path": "pages/week/index",
      "style": { "navigationBarTitleText": "训练安排" }
    },
    {
      "path": "pages/profile/index",
      "style": { "navigationBarTitleText": "我的", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/album/index",
      "style": { "navigationBarTitleText": "照片" }
    },
    {
      "path": "pages/recognition-log/index",
      "style": { "navigationBarTitleText": "识别明细" }
    }
  ],
  "tabBar": {
    "custom": true,
    "color": "#9a9ea3",
    "selectedColor": "#17191d",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/home/index", "text": "首页" },
      { "pagePath": "pages/log/index", "text": "日志" },
      { "pagePath": "pages/stats/index", "text": "统计" },
      { "pagePath": "pages/profile/index", "text": "我的" }
    ]
  },
  "globalStyle": {
    "navigationStyle": "custom",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "fit-app",
    "navigationBarBackgroundColor": "#F3F4EF",
    "backgroundColor": "#F3F4EF"
  }
}
