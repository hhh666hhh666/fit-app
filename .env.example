# 本机 / 服务器环境变量样例。复制成 .env 后填真值；**两个文件都不入库**。
# 后端配置的默认值只服务本机裸跑，容器里一律由 compose 注入这里的值覆盖。

# ── 数据库 ──
MYSQL_ROOT_PASSWORD=change-me
# 后端「本机裸跑」（mvn spring-boot:run）时用的数据源密码——它读不到容器那套环境变量，
# 必须与上面的值一致，否则症状是「容器 healthy 但后端报 Access denied」。
SPRING_DATASOURCE_PASSWORD=change-me
MYSQL_DATABASE=fit_app
# Linux 绝对路径；Windows 上写成 E:/develop/docker/<项目>/var/lib/mysql
MYSQL_DATA_DIR=./.data/mysql

# ── JWT ──
# ⚠️ 必须是随机值，至少 32 字节。生成：python -c "import secrets;print(secrets.token_hex(32))"
FITAPP_JWT_SECRET=please-generate-a-random-32-byte-secret
FITAPP_JWT_EXPIRE_DAYS=7

# ── 部署（可选章节用；不带 --with-deploy 时这几行用不到）──
ACR_REGISTRY=
ACR_NAMESPACE=fit-app
APP_VERSION=
