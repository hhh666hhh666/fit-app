{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "baseUrl": ".",
    "types": ["element-plus/global"],
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../frontend/src/utils/*"]
    }
  },
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue", "../frontend/src/utils/food-fields.ts"],
  "exclude": ["node_modules", "dist"]
}
